import React, { useState } from 'react';
import { useQuery } from 'react-query';
import { 
  Edit, 
  Trash2, 
  Eye,
  X,
  Search,
  Grid3X3,
  List,
  MoreVertical,
  Phone,
  MapPin,
  Calendar,
  User,
  FileText,
  Briefcase,
  Shield,
  Key,
  Users
} from 'lucide-react';
import { adminAPI } from '../../services/api';
import toast from 'react-hot-toast';
import InitialsAvatar from '../../components/InitialsAvatar';
import './AdminPatients.css';

const AdminPatients = () => {
  const [selectedPatient, setSelectedPatient] = useState(null);
  const [editingPatient, setEditingPatient] = useState(null);
  const [showGenerateAccountModal, setShowGenerateAccountModal] = useState(false);
  const [generatedCredentials, setGeneratedCredentials] = useState(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [viewMode, setViewMode] = useState('grid'); // 'grid' or 'list'
  const [activeDropdown, setActiveDropdown] = useState(null); // Track which dropdown is open
  const [newPatient, setNewPatient] = useState({
    name: '',
    email: ''
  });

  // Fetch patients data from API
  const { data: patientsData, isLoading, error, refetch } = useQuery(
    'adminPatients',
    () => adminAPI.getPatients(),
    {
      onError: (error) => {
        console.error('Error fetching patients:', error);
        toast.error('Failed to load patients data');
      }
    }
  );

  // Transform the data to match our expected format
  const allPatients = patientsData?.data?.data?.patients?.map(patient => ({
    id: patient.id,
    name: `${patient.firstName} ${patient.lastName}`,
    email: patient.email,
    phone: patient.phone,
    dateOfBirth: patient.dateOfBirth,
    gender: patient.gender,
    address: patient.address,
    city: patient.city,
    state: patient.state,
    zipCode: patient.zipCode,
    country: patient.country,
    medicalHistory: patient.medicalHistory || 'Not provided',
    currentMedications: patient.currentMedications || 'Not provided',
    allergies: patient.allergies || 'Not provided',
    emergencyContact: patient.emergencyContact || 'Not provided',
    emergencyPhone: patient.emergencyPhone || 'Not provided',
    insuranceProvider: patient.insuranceProvider || 'Not provided',
    insuranceNumber: patient.insuranceNumber || 'Not provided',
    status: patient.status || 'active',
    createdAt: patient.createdAt
  })) || [];

  // Filter patients based on search term
  const patients = allPatients.filter(patient => {
    if (!searchTerm) return true;
    const searchLower = searchTerm.toLowerCase();
    return (
      patient.name.toLowerCase().includes(searchLower) ||
      patient.email.toLowerCase().includes(searchLower) ||
      (patient.phone && patient.phone.toLowerCase().includes(searchLower)) ||
      (patient.city && patient.city.toLowerCase().includes(searchLower)) ||
      (patient.state && patient.state.toLowerCase().includes(searchLower)) ||
      (patient.medicalHistory && patient.medicalHistory.toLowerCase().includes(searchLower)) ||
      (patient.currentMedications && patient.currentMedications.toLowerCase().includes(searchLower)) ||
      (patient.allergies && patient.allergies.toLowerCase().includes(searchLower))
    );
  });

  const handleView = (patient) => {
    setSelectedPatient(patient);
  };

  const handleEdit = (patient) => {
    setEditingPatient(patient);
  };

  const handleDelete = async (patientId) => {
    if (window.confirm('Are you sure you want to delete this patient?')) {
      try {
        await adminAPI.deletePatient(patientId);
        toast.success('Patient deleted successfully');
        refetch();
      } catch (error) {
        console.error('Error deleting patient:', error);
        toast.error('Failed to delete patient');
      }
    }
  };

  const handleSave = async () => {
    if (editingPatient) {
      try {
        await adminAPI.updatePatient(editingPatient.id, editingPatient);
        toast.success('Patient updated successfully');
        setEditingPatient(null);
        refetch();
      } catch (error) {
        console.error('Error updating patient:', error);
        toast.error('Failed to update patient');
      }
    }
  };

  const handleCancel = () => {
    setEditingPatient(null);
  };

  const generateCredentials = async () => {
    if (newPatient.name && newPatient.email) {
      try {
        // Generate a random password
        const password = Math.random().toString(36).slice(-8);
        
        const userData = {
          firstName: newPatient.name.split(' ')[0],
          lastName: newPatient.name.split(' ').slice(1).join(' ') || '',
          email: newPatient.email,
          password: password,
          role: 'patient'
        };

        const response = await adminAPI.createPatient(userData);
        
        const credentials = {
          email: newPatient.email,
          password: password,
          patientId: response.data.patient.id
        };
        
        setGeneratedCredentials(credentials);
        toast.success('Patient account created successfully');
        refetch();
      } catch (error) {
        console.error('Error creating patient:', error);
        toast.error('Failed to create patient account');
      }
    }
  };

  const handleInputChange = (field, value) => {
    if (editingPatient) {
      setEditingPatient({ ...editingPatient, [field]: value });
    } else if (showGenerateAccountModal) {
      setNewPatient({ ...newPatient, [field]: value });
    }
  };

  const copyToClipboard = (text) => {
    navigator.clipboard.writeText(text);
    toast.success('Copied to clipboard');
  };

  const closeGenerateModal = () => {
    setShowGenerateAccountModal(false);
    setGeneratedCredentials(null);
    setNewPatient({
      name: '',
      email: ''
    });
  };

  const toggleDropdown = (patientId) => {
    setActiveDropdown(activeDropdown === patientId ? null : patientId);
  };

  const closeDropdown = () => {
    setActiveDropdown(null);
  };

  const closeDropdownWithDelay = () => {
    setTimeout(() => {
      setActiveDropdown(null);
    }, 100);
  };

  if (isLoading) {
    return (
      <div className="admin-dashboard">
        <div className="flex items-center justify-center h-64">
          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="admin-dashboard">
        <div className="text-center py-12">
          <div className="text-red-600 mb-4">Error loading patients data</div>
          <button onClick={() => refetch()} className="patient-btn-primary">
            Try Again
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="admin-dashboard" onClick={closeDropdown}>
      {/* Header */}
      <div className="welcome-section">
        <div className="welcome-content">
          <div className="welcome-text">
            <h1 className="flex items-center gap-3">
              <div className="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <Users className="h-6 w-6 text-blue-600" />
              </div>
              Patient Management
            </h1>
            <p>Manage patient accounts and medical information</p>
          </div>
          <div className="welcome-actions">
            <div className="flex items-center gap-3">
              {/* View Toggle Buttons */}
              <div className="flex items-center bg-gray-100 rounded-lg p-1">
                <button
                  onClick={() => setViewMode('grid')}
                  className={`flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                    viewMode === 'grid'
                      ? 'bg-white text-gray-900 shadow-sm'
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  <Grid3X3 size={16} />
                  Grid
                </button>
                <button
                  onClick={() => setViewMode('list')}
                  className={`flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                    viewMode === 'list'
                      ? 'bg-white text-gray-900 shadow-sm'
                      : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  <List size={16} />
                  List
                </button>
              </div>
              
              <button className="patient-btn-primary" onClick={() => setShowGenerateAccountModal(true)}>
                <Key size={16} />
                Generate Account
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Search Bar */}
      <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200 mb-6">
        <div className="relative">
          <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <Search className="h-5 w-5 text-gray-400" />
          </div>
          <input
            type="text"
            placeholder="Search patients by name, email, phone, location, or medical info..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="block w-full pl-10 pr-10 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 text-sm"
          />
          {searchTerm && (
            <button
              onClick={() => setSearchTerm('')}
              className="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 transition-colors duration-200"
              title="Clear search"
            >
              <X className="h-4 w-4" />
            </button>
          )}
        </div>
        {searchTerm && (
          <div className="mt-2 text-sm text-gray-600">
            Showing {patients.length} of {allPatients.length} patients
          </div>
        )}
      </div>

      {/* Patients Grid/List */}
      {viewMode === 'grid' ? (
        <div className="patients-grid">
          {patients.map(patient => (
            <div key={patient.id} className="patient-card">
              <div className="patient-header">
                <InitialsAvatar 
                  name={patient.name} 
                  size="lg" 
                  className="patient-avatar"
                />
                <div className="patient-info">
                  <h3>{patient.name}</h3>
                  <p className="patient-email">
                    {patient.email}
                  </p>
                </div>
                <span className={`status-badge ${patient.status}`}>
                  {patient.status}
                </span>
              </div>
              
              <div className="patient-details">
                <div className="detail-item">
                  <span className="label">Phone:</span>
                  <span>{patient.phone || 'Not provided'}</span>
                </div>
                <div className="detail-item">
                  <span className="label">Location:</span>
                  <span>{patient.city}, {patient.state}</span>
                </div>
                <div className="detail-item">
                  <span className="label">Insurance:</span>
                  <span>{patient.insuranceProvider || 'Not provided'}</span>
                </div>
              </div>
              
              <div className="patient-actions">
                <button className="patient-action-btn" onClick={() => handleView(patient)}>
                  <Eye size={16} />
                  View
                </button>
                <button className="patient-action-btn" onClick={() => handleEdit(patient)}>
                  <Edit size={16} />
                  Edit
                </button>
                <button className="patient-action-btn danger" onClick={() => handleDelete(patient.id)}>
                  <Trash2 size={16} />
                  Delete
                </button>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div className="patients-list">
          <div className="list-header">
            <div className="list-header-cell">Patient</div>
            <div className="list-header-cell">Contact</div>
            <div className="list-header-cell">Location</div>
            <div className="list-header-cell">Insurance</div>
            <div className="list-header-cell">Status</div>
            <div className="list-header-cell">Actions</div>
          </div>
          
          {patients.map(patient => (
            <div key={patient.id} className="list-item">
              <div className="list-cell patient-info-cell">
                <InitialsAvatar 
                  name={patient.name} 
                  size="md" 
                  className="patient-avatar"
                />
                <div>
                  <div className="patient-name">{patient.name}</div>
                  <div className="patient-email">{patient.email}</div>
                </div>
              </div>
              
              <div className="list-cell">
                <div className="contact-info">
                  <Phone size={16} className="contact-icon" />
                  <span className="contact-text">
                    {patient.phone || 'Not provided'}
                  </span>
                </div>
              </div>
              
              <div className="list-cell">
                <div className="location-info">
                  <MapPin size={16} className="location-icon" />
                  <span className="location-text">
                    {patient.city}, {patient.state}
                  </span>
                </div>
              </div>
              
              <div className="list-cell">
                <span className="insurance-text">
                  {patient.insuranceProvider || 'Not provided'}
                </span>
              </div>
              
              <div className="list-cell">
                <span className={`status-badge-list ${patient.status}`}>
                  {patient.status}
                </span>
              </div>
              
              <div className="list-cell">
                <div className="dropdown-container" onClick={(e) => e.stopPropagation()}>
                  <button 
                    className="dropdown-trigger" 
                    onClick={() => toggleDropdown(patient.id)}
                    title="Actions"
                  >
                    <MoreVertical size={16} />
                  </button>
                  
                  {activeDropdown === patient.id && (
                    <div className="dropdown-menu">
                      <button 
                        className="dropdown-item" 
                        onClick={() => {
                          console.log('View details clicked for patient:', patient.id);
                          handleView(patient);
                          closeDropdownWithDelay();
                        }}
                      >
                        <Eye size={16} />
                        <span>View Details</span>
                      </button>
                      <button 
                        className="dropdown-item" 
                        onClick={() => {
                          console.log('Edit clicked for patient:', patient.id);
                          handleEdit(patient);
                          closeDropdownWithDelay();
                        }}
                      >
                        <Edit size={16} />
                        <span>Edit</span>
                      </button>
                      <button 
                        className="dropdown-item danger" 
                        onClick={() => {
                          console.log('Delete clicked for patient:', patient.id);
                          handleDelete(patient.id);
                          closeDropdownWithDelay();
                        }}
                      >
                        <Trash2 size={16} />
                        <span>Delete</span>
                      </button>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
          
          {patients.length === 0 && (
            <div className="list-empty-state">
              <div className="text-center py-12">
                <Users className="mx-auto h-12 w-12 text-gray-400 mb-4" />
                <h3 className="text-lg font-medium text-gray-900 mb-2">No patients found</h3>
                <p className="text-gray-500 mb-4">
                  {searchTerm ? 'Try adjusting your search terms' : 'Get started by creating a new patient account'}
                </p>
                {!searchTerm && (
                  <button 
                    className="patient-btn-primary" 
                    onClick={() => setShowGenerateAccountModal(true)}
                  >
                    <Key size={16} />
                    Generate Account
                  </button>
                )}
              </div>
            </div>
          )}
        </div>
      )}

      {/* View Patient Modal */}
      {selectedPatient && (
        <div className="modal-overlay" onClick={() => setSelectedPatient(null)}>
          <div className="modal-content patient-detail-modal" onClick={e => e.stopPropagation()}>
            <div className="modal-header">
              <h3>Patient Profile</h3>
              <button className="close-btn" onClick={() => setSelectedPatient(null)}>
                <X size={20} />
              </button>
            </div>
            <div className="modal-body">
              <div className="patient-detail-modern">
                <div className="patient-header">
                  <div className="avatar-container">
                    <InitialsAvatar 
                      name={selectedPatient.name} 
                      size="xl" 
                      className="patient-avatar"
                    />
                    <div className={`status-indicator ${selectedPatient.status}`}></div>
                  </div>
                  <div className="patient-basic-info">
                    <h2 className="patient-name">{selectedPatient.name}</h2>
                    <p className="patient-email">{selectedPatient.email}</p>
                    <div className="patient-stats">
                      <div className="stat-item">
                        <Calendar size={16} className="stat-icon" />
                        <span className="stat-value">{selectedPatient.dateOfBirth ? new Date(selectedPatient.dateOfBirth).toLocaleDateString() : 'Not provided'}</span>
                        <span className="stat-label">Date of Birth</span>
                      </div>
                      <div className="stat-item">
                        <User size={16} className="stat-icon" />
                        <span className="stat-value">{selectedPatient.gender || 'Not provided'}</span>
                        <span className="stat-label">Gender</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="detail-section">
                  <h3 className="section-title">Contact Information</h3>
                  <div className="detail-grid">
                    <div className="detail-item">
                      <Phone size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Phone</span>
                        <span className="detail-value">{selectedPatient.phone || 'Not provided'}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <Mail size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Email</span>
                        <span className="detail-value">{selectedPatient.email}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <MapPin size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Address</span>
                        <span className="detail-value">
                          {selectedPatient.address ? 
                            `${selectedPatient.address}, ${selectedPatient.city}, ${selectedPatient.state} ${selectedPatient.zipCode}` : 
                            'Not provided'
                          }
                        </span>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="detail-section">
                  <h3 className="section-title">Medical Information</h3>
                  <div className="detail-grid">
                    <div className="detail-item">
                      <FileText size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Medical History</span>
                        <span className="detail-value">{selectedPatient.medicalHistory}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <Briefcase size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Current Medications</span>
                        <span className="detail-value">{selectedPatient.currentMedications}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <Shield size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Allergies</span>
                        <span className="detail-value">{selectedPatient.allergies}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="detail-section">
                  <h3 className="section-title">Emergency Contact</h3>
                  <div className="detail-grid">
                    <div className="detail-item">
                      <User size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Contact Name</span>
                        <span className="detail-value">{selectedPatient.emergencyContact}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <Phone size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Contact Phone</span>
                        <span className="detail-value">{selectedPatient.emergencyPhone}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="detail-section">
                  <h3 className="section-title">Insurance Information</h3>
                  <div className="detail-grid">
                    <div className="detail-item">
                      <FileText size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Provider</span>
                        <span className="detail-value">{selectedPatient.insuranceProvider}</span>
                      </div>
                    </div>
                    <div className="detail-item">
                      <FileText size={16} className="detail-icon" />
                      <div>
                        <span className="detail-label">Policy Number</span>
                        <span className="detail-value">{selectedPatient.insuranceNumber}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div className="modal-footer">
              <button 
                onClick={() => setSelectedPatient(null)}
                className="patient-btn-secondary"
              >
                Close
              </button>
              <button 
                onClick={() => {
                  setSelectedPatient(null);
                  handleEdit(selectedPatient);
                }}
                className="patient-btn-primary"
              >
                <Edit size={16} />
                Edit Patient
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Edit Patient Modal */}
      {editingPatient && (
        <div className="modal-overlay" onClick={handleCancel}>
          <div className="modal-content" onClick={e => e.stopPropagation()}>
            <div className="modal-header">
              <h3>Edit Patient</h3>
              <button className="close-btn" onClick={handleCancel}>
                <X size={20} />
              </button>
            </div>
            <div className="modal-body">
              <div className="form-grid">
                <div className="form-group">
                  <label>First Name</label>
                  <input
                    type="text"
                    value={editingPatient.name.split(' ')[0] || ''}
                    onChange={(e) => {
                      const lastName = editingPatient.name.split(' ').slice(1).join(' ') || '';
                      handleInputChange('name', `${e.target.value} ${lastName}`.trim());
                    }}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Last Name</label>
                  <input
                    type="text"
                    value={editingPatient.name.split(' ').slice(1).join(' ') || ''}
                    onChange={(e) => {
                      const firstName = editingPatient.name.split(' ')[0] || '';
                      handleInputChange('name', `${firstName} ${e.target.value}`.trim());
                    }}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Email</label>
                  <input
                    type="email"
                    value={editingPatient.email}
                    onChange={(e) => handleInputChange('email', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Phone</label>
                  <input
                    type="tel"
                    value={editingPatient.phone || ''}
                    onChange={(e) => handleInputChange('phone', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Date of Birth</label>
                  <input
                    type="date"
                    value={editingPatient.dateOfBirth ? new Date(editingPatient.dateOfBirth).toISOString().split('T')[0] : ''}
                    onChange={(e) => handleInputChange('dateOfBirth', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Gender</label>
                  <select
                    value={editingPatient.gender || ''}
                    onChange={(e) => handleInputChange('gender', e.target.value)}
                    className="form-input"
                  >
                    <option value="">Select Gender</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div className="form-group">
                  <label>Address</label>
                  <input
                    type="text"
                    value={editingPatient.address || ''}
                    onChange={(e) => handleInputChange('address', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>City</label>
                  <input
                    type="text"
                    value={editingPatient.city || ''}
                    onChange={(e) => handleInputChange('city', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>State</label>
                  <input
                    type="text"
                    value={editingPatient.state || ''}
                    onChange={(e) => handleInputChange('state', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>ZIP Code</label>
                  <input
                    type="text"
                    value={editingPatient.zipCode || ''}
                    onChange={(e) => handleInputChange('zipCode', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Country</label>
                  <input
                    type="text"
                    value={editingPatient.country || ''}
                    onChange={(e) => handleInputChange('country', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Medical History</label>
                  <textarea
                    value={editingPatient.medicalHistory || ''}
                    onChange={(e) => handleInputChange('medicalHistory', e.target.value)}
                    className="form-input"
                    rows="3"
                  />
                </div>
                <div className="form-group">
                  <label>Current Medications</label>
                  <textarea
                    value={editingPatient.currentMedications || ''}
                    onChange={(e) => handleInputChange('currentMedications', e.target.value)}
                    className="form-input"
                    rows="3"
                  />
                </div>
                <div className="form-group">
                  <label>Allergies</label>
                  <textarea
                    value={editingPatient.allergies || ''}
                    onChange={(e) => handleInputChange('allergies', e.target.value)}
                    className="form-input"
                    rows="3"
                  />
                </div>
                <div className="form-group">
                  <label>Emergency Contact</label>
                  <input
                    type="text"
                    value={editingPatient.emergencyContact || ''}
                    onChange={(e) => handleInputChange('emergencyContact', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Emergency Phone</label>
                  <input
                    type="tel"
                    value={editingPatient.emergencyPhone || ''}
                    onChange={(e) => handleInputChange('emergencyPhone', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Insurance Provider</label>
                  <input
                    type="text"
                    value={editingPatient.insuranceProvider || ''}
                    onChange={(e) => handleInputChange('insuranceProvider', e.target.value)}
                    className="form-input"
                  />
                </div>
                <div className="form-group">
                  <label>Insurance Number</label>
                  <input
                    type="text"
                    value={editingPatient.insuranceNumber || ''}
                    onChange={(e) => handleInputChange('insuranceNumber', e.target.value)}
                    className="form-input"
                  />
                </div>
              </div>
            </div>
            <div className="modal-footer">
              <button 
                onClick={handleCancel}
                className="patient-btn-secondary"
              >
                Cancel
              </button>
              <button 
                onClick={handleSave}
                className="patient-btn-primary"
              >
                <Save size={16} />
                Save Changes
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Generate Account Modal */}
      {showGenerateAccountModal && (
        <div className="modal-overlay" onClick={closeGenerateModal}>
          <div className="modal-content" onClick={e => e.stopPropagation()}>
            <div className="modal-header">
              <h3>Generate Patient Account</h3>
              <button className="close-btn" onClick={closeGenerateModal}>
                <X size={20} />
              </button>
            </div>
            <div className="modal-body">
              {!generatedCredentials ? (
                <div className="form-grid">
                  <div className="form-group">
                    <label>Patient Name</label>
                    <input
                      type="text"
                      value={newPatient.name}
                      onChange={(e) => handleInputChange('name', e.target.value)}
                      className="form-input"
                      placeholder="Enter patient's full name"
                    />
                  </div>
                  <div className="form-group">
                    <label>Email Address</label>
                    <input
                      type="email"
                      value={newPatient.email}
                      onChange={(e) => handleInputChange('email', e.target.value)}
                      className="form-input"
                      placeholder="Enter patient's email address"
                    />
                  </div>
                </div>
              ) : (
                <div className="credentials-display">
                  <div className="success-message">
                    <div className="success-icon">
                      <UserCheck size={24} />
                    </div>
                    <h4>Account Created Successfully!</h4>
                    <p>Patient account has been created. Please provide these credentials to the patient.</p>
                  </div>
                  
                  <div className="credentials-info">
                    <div className="credential-item">
                      <label>Email:</label>
                      <div className="credential-value">
                        <span>{generatedCredentials.email}</span>
                        <button 
                          onClick={() => copyToClipboard(generatedCredentials.email)}
                          className="copy-btn"
                        >
                          Copy
                        </button>
                      </div>
                    </div>
                    <div className="credential-item">
                      <label>Temporary Password:</label>
                      <div className="credential-value">
                        <span>{generatedCredentials.password}</span>
                        <button 
                          onClick={() => copyToClipboard(generatedCredentials.password)}
                          className="copy-btn"
                        >
                          Copy
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
            <div className="modal-footer">
              <button 
                onClick={closeGenerateModal}
                className="patient-btn-secondary"
              >
                {generatedCredentials ? 'Close' : 'Cancel'}
              </button>
              {!generatedCredentials && (
                <button 
                  className="patient-btn-primary" 
                  onClick={generateCredentials}
                  disabled={!newPatient.name || !newPatient.email}
                >
                  <Key size={16} />
                  Generate Account
                </button>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default AdminPatients;