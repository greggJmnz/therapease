# TherapEase Production Environment Example
# Copy these values into Railway variables for the backend service.

# Database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TYPE=mysql

# Authentication and encryption
JWT_SECRET=
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend and CORS
FRONTEND_URL=
CORS_ORIGIN=
PORT=5000
NODE_ENV=production

# Client env values for the Vite frontend
VITE_API_URL=
VITE_PUBLIC_WEBSITE_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_LOG_LEVEL=error

# Storage
UPLOAD_STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# SMS / notifications
SMS_ENABLED=false
PHILSMS_API_TOKEN=
PHILSMS_BASE_URL=https://app.philsms.com/api/v3
PHILSMS_SENDER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Logging
LOG_LEVEL=info
