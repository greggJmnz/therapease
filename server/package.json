{
  "name": "therapease-server",
  "version": "1.0.0",
  "description": "TherapEase Backend API Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup": "node -e \"require('./config/database').performCompleteSetup()\"",
    "setup:env": "node -e \"require('./config/database').setupEnvironmentConfig()\"",
    "setup:ssl": "node -e \"require('./config/database').setupSSLCertificates()\"",
    "setup:vapid": "node -e \"require('./config/database').setupVAPIDKeys()\"",
    "setup:db": "node -e \"require('./config/database').createDatabase()\"",
    "db:init": "node scripts/migrate.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-production.js",
    "security:setup": "node scripts/setup-security.js",
    "ssl:generate": "node scripts/generate-ssl.js",
    "sms:setup": "node scripts/setup-sms.js",
    "vapid:generate": "node scripts/generate-vapid-keys.js",
    "clear:pending-therapists": "node scripts/clear-pending-therapists.js",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "echo \"No linting configured\" && exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.3.1",
    "helmet": "^7.1.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "openai": "^6.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "api",
    "backend",
    "occupational-therapy"
  ],
  "author": "TherapEase Team",
  "license": "MIT"
}
