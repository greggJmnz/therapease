{
  "name": "therapease-server",
  "version": "1.0.0",
  "description": "TherapEase Backend API Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:init": "node scripts/init-database.js",
    "security:setup": "node scripts/setup-security.js",
    "security:test": "curl -k https://localhost:5443/health/ssl",
    "ssl:generate": "openssl req -x509 -newkey rsa:4096 -keyout certs/server.key -out certs/server.crt -days 365 -nodes -subj '/C=US/ST=State/L=City/O=TherapEase/CN=localhost'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.3.1",
    "helmet": "^7.1.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.3",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "api",
    "backend",
    "occupational-therapy"
  ],
  "author": "TherapEase Team",
  "license": "MIT"
}
