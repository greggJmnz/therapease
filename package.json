{
  "name": "therapease",
  "version": "1.0.0",
  "description": "TherapEase - Professional Therapy Management System",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:public\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm start",
    "dev:public": "cd public-website && node server.js",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "setup": "npm run install:all && cd server && npm run setup",
    "test": "cd server && npm test",
    "lint": "cd client && npm run lint",
    "lint:fix": "cd client && npm run lint:fix"
  },
  "keywords": [
    "therapy",
    "healthcare",
    "management",
    "system",
    "patient",
    "therapist",
    "admin"
  ],
  "author": "TherapEase Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
