{
  "name": "therapease",
  "version": "1.0.0",
  "description": "TherapEase - Professional Therapy Management System",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:public\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm start",
    "dev:public": "cd public-website && node server.js",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "setup": "node setup.js",
    "setup:env": "cd server && npm run setup:env",
    "setup:ssl": "cd server && npm run setup:ssl",
    "setup:vapid": "cd server && npm run setup:vapid",
    "setup:db": "cd server && npm run setup:db",
    "setup:security": "cd server && npm run security:setup",
    "setup:sms": "cd server && npm run sms:setup",
    "postinstall": "npm run setup",
    "test": "cd server && npm test",
    "test:client": "cd client && npm test",
    "lint": "cd client && npm run lint",
    "lint:fix": "cd client && npm run lint:fix",
    "clean": "rm -rf node_modules server/node_modules client/node_modules",
    "clean:install": "npm run clean && npm run install:all",
    "reset": "npm run clean:install && npm run setup"
  },
  "keywords": [
    "therapy",
    "healthcare",
    "management",
    "system",
    "patient",
    "therapist",
    "admin"
  ],
  "author": "TherapEase Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
